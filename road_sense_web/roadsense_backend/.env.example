# Set explicit dashboard origins outside local development.
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# SMTP email delivery. SMTP_HOST and SMTP_FROM are required.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_TLS=true
SMTP_FROM=roadsense@example.com
SMTP_USERNAME=
SMTP_PASSWORD=

# Google OAuth. Required for reports to email authorities from each reporter's own Gmail.
# The redirect URI must exactly match the Google Cloud OAuth client configuration.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8001/auth/google/callback

# Twilio SMS delivery. All three values are required.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
