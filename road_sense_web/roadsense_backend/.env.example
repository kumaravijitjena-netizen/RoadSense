# Set explicit dashboard origins outside local development.
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Supabase PostgreSQL and private evidence storage.
# DATABASE_URL must use the Session pooler URI on port 5432.
DATABASE_URL=
SUPABASE_URL=
# Copy the server-only "Secret key" from Supabase Project Settings > API Keys.
# Never place this key in frontend code or a VITE_* variable.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=incident-media

# SMTP email delivery. SMTP_HOST and SMTP_FROM are required.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_TLS=true
SMTP_FROM=roadsense@example.com
SMTP_USERNAME=
SMTP_PASSWORD=

# Recommended on Render: send automated alerts over Gmail's HTTPS API instead
# of SMTP. Set this to a Gmail account connected through Google sign-in.
DEFAULT_GMAIL_SENDER=

# Google OAuth. Required for reports to email authorities from each reporter's own Gmail.
# The redirect URI must exactly match the Google Cloud OAuth client configuration.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8001/auth/google/callback

# Twilio SMS delivery. All three values are required.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# WhatsApp alerts use the same Twilio account. This must be a registered
# WhatsApp Business sender (for example: whatsapp:+14155238886).
TWILIO_WHATSAPP_FROM=

# Inbound SMS reporting. Add this public webhook URL in Twilio's Messaging settings.
# Example: https://your-service.onrender.com/webhooks/twilio/sms
TWILIO_SMS_WEBHOOK_URL=
TWILIO_REPORTING_NUMBER=

# SMS translation. Set this to your LibreTranslate-compatible /translate endpoint.
# It receives source=auto and target=en so incoming SMS can use any supported language.
TRANSLATION_URL=
TRANSLATION_API_KEY=

# Optional JSON mapping for custom models outside runs/<name>/weights/best.pt.
# ROADSENSE_MODELS={"cracks":"/models/cracks.pt","bumps":"/models/bumps.pt"}
ROADSENSE_MODELS=

# Shared authority-only portal. These credentials are not exposed to the frontend.
# AUTHORITY_PORTAL_EMAIL must match an enabled authority email record.
AUTHORITY_PORTAL_ID=
AUTHORITY_PORTAL_PASSWORD=
AUTHORITY_PORTAL_EMAIL=

# Public frontend base URL used in email password-reset links.
ROADSENSE_APP_URL=http://localhost:3000

# SMS translation. Set this to your LibreTranslate-compatible /translate endpoint.
# It receives source=auto and target=en so incoming SMS can use any supported language.
TRANSLATION_URL=
TRANSLATION_API_KEY=

# Optional JSON mapping for custom models outside runs/<name>/weights/best.pt.
# ROADSENSE_MODELS={"cracks":"/models/cracks.pt","bumps":"/models/bumps.pt"}
ROADSENSE_MODELS=
